# ════════════════════════════════════════════════
#  HYDRA — Environment Configuration
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════

# ── AI Providers ─────────────────────────────
# Engineering runtime: select an exact provider id with `hydra providers`.
# HYDRA_PROVIDER=ollama
# GEMINI_API_KEY=
# GEMINI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# MINIMAX_API_KEY=
# MINIMAX_MODEL=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# BEDROCK_MODEL=
# AWS_REGION=us-east-1
# At least one provider should be configured for AI features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Ollama (runs on host machine)
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Custom OpenAI-compatible API
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=

# ── Infrastructure ───────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=hydra
# Required only when starting the optional PostgreSQL/Compose infrastructure.
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
POSTGRES_DB=hydra

# ── MCP Server ───────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8900
MCP_TOOL_TIMEOUT=120
MCP_MAX_CONCURRENT=5

# ── Swarm ────────────────────────────────────
SWARM_MAX_AGENTS=10
SWARM_AGENT_TIMEOUT=300
WORKER_REPLICAS=2

# ── Distributed Mode ────────────────────────
HYDRA_DISTRIBUTED=false
HYDRA_NODE_ID=node-0
HYDRA_NODE_ROLE=all

# ── Security API Keys (optional) ────────────
SHODAN_API_KEY=
VT_API_KEY=
ST_API_KEY=
GITHUB_TOKEN=
CENSYS_ID=
CENSYS_SECRET=
