{
  "manifest_version": 3,
  "name": "HYDRA Browser Bridge",
  "description": "Opt-in browser QA and scoped evidence collection for local HYDRA sessions.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Pair a tab with HYDRA"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
