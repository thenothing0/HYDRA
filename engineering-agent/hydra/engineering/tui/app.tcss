Screen { background: #101318; color: #dce3ed; }
#brand { height: 2; padding: 0 1; text-style: bold; color: #73e2cc; border-bottom: solid #28323d; }
#configuration { height: 3; padding: 0 1; background: #171d25; }
#provider { width: 31; }
#model { width: 1fr; margin: 0 1; }
#permissions { width: auto; padding: 1; color: #e3c882; }
#workspace { height: 1fr; }
#sessions-panel { width: 28; padding: 1; border-right: solid #28323d; background: #141920; }
.eyebrow { color: #8295ab; text-style: bold; margin: 1 0; }
#workspace-path { height: auto; max-height: 4; color: #b1c0d1; }
#sessions { height: 1fr; margin-top: 1; }
.session-item { height: 4; padding: 0 1; }
#new-session, #resume-session { width: 100%; }
#conversation-column { width: 1fr; }
#conversation { height: 1fr; padding: 1 3; }
#welcome-logo { margin-top: 2; height: 3; text-style: bold; }
#welcome { height: auto; color: #9daebf; margin-bottom: 2; }
.message { height: auto; padding: 1 2; margin-bottom: 1; border-left: solid #344354; background: #151b23; }
.message.user { border-left: solid #73e2cc; background: #1a262a; }
.message.error { border-left: solid #e47f83; }
.message.result { color: #a9b9ca; }
#run-status { height: 1; margin: 0 2; color: #83bda8; }
#prompt { height: 5; margin: 1 2 0 2; border: round #426d68; background: #171f28; }
#prompt:focus { border: round #73e2cc; }
#prompt-help { height: 1; margin: 0 3; color: #8295ab; }
#inspector { width: 39; border-left: solid #28323d; padding: 1; background: #141920; }
#plan, #diff { height: auto; padding: 1; }
Footer { background: #171d25; }
CommandApproval { align: center middle; background: #000000 65%; }
#approval-dialog { width: 76; max-width: 95%; height: auto; max-height: 90%; padding: 1 2; border: round #e3c882; background: #171f28; }
.dialog-title { text-style: bold; color: #e3c882; margin-bottom: 1; }
#command-preview { height: auto; max-height: 12; overflow-y: auto; margin-bottom: 1; }
.dialog-buttons { height: 3; margin-top: 1; align-horizontal: right; }
.dialog-buttons Button { margin-left: 1; }
ModelSelection { align: center middle; background: #000000 65%; }
#model-dialog { width: 76; max-width: 95%; height: auto; max-height: 95%; overflow-y: auto; padding: 1 2; border: round #73e2cc; background: #171f28; }
#model-dialog > Label { height: auto; margin-bottom: 1; }
#model-provider, #model-id { width: 100%; margin-bottom: 1; }
#model-dialog > Static { height: auto; color: #9daebf; }
